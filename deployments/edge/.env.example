# Edge Server Environment Configuration
# Copy this file to .env and modify the values

# Edge Device ID (unique identifier for this edge device)
#
# 必须与 Center 上注册的 edge_code 完全一致，否则鉴权第三重校验会拒绝（403）。
# 注册：POST /v1/edges（管理员用户 JWT）
EDGE_ID=edge-001

# Device credential for uploading to Center —— 必填
#
# 缺失时进程会直接退出（log.Fatal），在 restart: unless-stopped 下表现为崩溃循环。
# 获取方式：在 Center 上以管理员用户 JWT 调用
#   POST /v1/edges/{EDGE_ID}/token
# 有效期由 Center 的 EDGE_TOKEN_TTL 控制（默认 30 天）；到期后 Edge 不会自动续期，
# 需要重新获取并重启，否则上传会返回 401、记录停在 pending。
CENTER_TOKEN=

# JWT Secret Key (use a strong random string in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production

# Center Server URL
CENTER_URL=http://localhost:8080

# Optional: 兜底重试间隔，默认 5m
# 实时上传由业务操作触发，本间隔仅用于网络故障后的重试。
# 必须为正数（如 30s / 5m / 1h）；填 0 或负数会回退到默认值。
# SYNC_INTERVAL=5m

# Optional: Custom port (default: 8081)
# PORT=8081

# Optional: Custom database path (default: ./edge.db)
# DATABASE_PATH=/data/edge.db

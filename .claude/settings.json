{
  "permissions": {
    "allow": [
      "Bash(ls -la \"F:/worktemp/第二版本程序/Hive/DataBase/nodes7/\" 2>/dev/null)",
      "Read(//f/worktemp/第二版本程序/Hive/DataBase/nodes7/**)",
      "Bash(# Check DBeaver directory *)",
      "Read(//f/worktemp/第二版本程序/Hive/DataBase/DBeaver/**)",
      "Bash(# Read more table structures: movements, doffings, spinnings *)",
      "Read(//f/worktemp/第二版本程序/Hive/DataBase/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "veans prime"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session-init.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/git-session-check.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "veans prime"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/encoding-check.sh"
          }
        ]
      },
      {
        "matcher": "Bash(git reset*)|Bash(git push*)|Bash(git checkout -- *)|Bash(git clean*)|Bash(git rebase*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/git-danger-warn.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/git-dirty-remind.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-archive.sh"
          }
        ]
      }
    ]
  }
}
